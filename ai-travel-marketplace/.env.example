# Local-only application secret; replace for any non-local deployment.
JWT_SECRET=local-only-change-this-secret
PAYMENT_SIMULATOR_MODE=normal
SEARCH_ADMIN_TOKEN=local-only-search-admin-token

# AI is optional. Without a key, the marketplace remains available and AI
# endpoints return an explicit 503 degraded response.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional: set medium for reasoning-capable models; leave blank otherwise.
OPENAI_REASONING_EFFORT=
