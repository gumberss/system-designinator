{
  "name": "ride-hailing-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/runtime/server.js",
    "dev": "docker compose up -d --build",
