    "simulate": "node dist/tools/simulator.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
