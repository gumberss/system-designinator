# Generate a local password before starting Compose. Never commit .env.
MAPINATOR_DB_PASSWORD=
# For commands on the host, export a URL with the same password:
# MAPINATOR_DATABASE_URL=postgresql+psycopg://mapinator:<password>@127.0.0.1:58432/mapinator
MAPINATOR_ALLOWED_ORIGINS=http://127.0.0.1:58180,http://localhost:58180
MAPINATOR_COOKIE_SECURE=false
# Optional MapLibre style URL. Empty means local geometry only, without external tiles.
MAPINATOR_MAP_STYLE_URL=
# Host CLI only; Compose workers use broker:9092.
MAPINATOR_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:59092
# Host API; Redis profile uses the project-local DB password.
# MAPINATOR_REDIS_URL=redis://:<password>@127.0.0.1:56379/0
# Optional actual local Ollama model, explicitly configured; no simulated fallback.
MAPINATOR_LLM_MODEL=
# Host API defaults to http://127.0.0.1:11434. Compose uses host.docker.internal.
# MAPINATOR_LLM_BASE_URL=http://127.0.0.1:11434
