{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"short-term-rental.sln",
				"-c",
				"Release"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "verify concurrency",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src\\ShortTermRental.Simulator",
				"-c",
				"Release",
				"--no-build",
				"--",
				"verify"
			],
			"problemMatcher": []
		},
		{
			"label": "verify multi-instance",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src\\ShortTermRental.Simulator",
				"-c",
				"Release",
				"--no-build",
				"--",
				"verify",
				"--second-url",
				"http://localhost:58081",
				"--attempts",
				"1000",
				"--concurrency",
				"64"
			],
			"problemMatcher": []
		},
		{
			"label": "verify service failures",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-File",
				"scripts\\Test-Failures.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "load catalog",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src\\ShortTermRental.Simulator",
				"-c",
				"Release",
				"--no-build",
				"--",
				"load",
				"--duration",
				"20",
				"--concurrency",
				"32",
				"--read-percent",
				"90",
				"--hotspot-percent",
				"10",
				"--read-mode",
				"catalog"
			],
			"problemMatcher": []
		},
