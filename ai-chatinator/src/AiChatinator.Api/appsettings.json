{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "RequestsPerMinute": 10
  },
  "Files": {
    "MaximumBytes": 10485760
  },
  "DomainEvents": {
    "Transport": "Local"
  },
  "Auth": {
    "Mode": "Local",
    "Cognito": {
      "Authority": "",
      "ClientId": ""
    }
  },
  "Ai": {
    "Provider": "LocalDemo",
    "Context": {
      "CompactAtTokens": 6144,
      "KeepRecentMessages": 12
    },
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1/",
      "Model": "",
      "TimeoutSeconds": 60
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
